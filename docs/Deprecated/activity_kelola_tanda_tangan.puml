@startuml
title Activity Diagram: Mengelola Tanda Tangan Digital

|Direktur|
start
:Membuka menu "Pengaturan" -> "Kelola Tanda Tangan";

|Sistem|
:Menampilkan halaman dengan daftar tanda tangan yang ada dan form tambah baru;

|Direktur|
partition "Menambah Tanda Tangan Baru" {
    :Mengisi form:\n- Nama Tanda Tangan\n- Nama Pemilik\n- Mengunggah File Gambar;
    :Menekan tombol "Simpan Tanda Tangan";

    |Sistem|
    :Memvalidasi data input;
    :Menyimpan file gambar ke storage;
    :Membuat record baru di tabel `signatures` dengan `is_active` = false;
    :Refresh halaman dengan daftar yang diperbarui;
}

|Direktur|
partition "Mengelola Tanda Tangan yang Ada" {
    if (Pilih aksi pada salah satu tanda tangan?) then (Jadikan Aktif)
        :Menekan tombol "Jadikan Aktif";

        |Sistem|
        :Mengubah `is_active` = false untuk semua record lain;
        :Mengubah `is_active` = true untuk record yang dipilih;
        :Refresh halaman;

    else (Hapus)
        :Menekan tombol "Hapus";

        |Sistem|
        :Menampilkan konfirmasi;

        |Direktur|
        if (Konfirmasi "Ya"?) then (Ya)
            |Sistem|
            :Menghapus record dari tabel `signatures`;
            :Menghapus file gambar dari storage;
            :Refresh halaman;
        else (Tidak)
            'Aksi dibatalkan
        endif
    endif
}

stop

@enduml
